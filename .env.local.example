# NexaDrop backend — entorno local
# Copia este archivo a `.env.local` y rellena con TUS credenciales del proyecto.
# El archivo `.env.local` está en .gitignore y NO debe commitearse.
#
# Cómo cargar al lanzar:
#   set -a; . backend/.env.local; set +a
#   java -jar target/dropshipping-backend-0.0.1-SNAPSHOT.jar --spring.profiles.active=local
#
# Si dejas vacío STRIPE_SECRET_KEY o STRIPE_ENABLED=false, el StripeGateway
# entra en MODO MOCK (devuelve `pi_mock_*` clientSecret sintético — útil en
# dev y para el E2E). Lo mismo para PayPal y Coinbase.

# ========== Stripe (CARD payments) ==========
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ========== PayPal ==========
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:3003/wallet/paypal-return
PAYPAL_CANCEL_URL=http://localhost:3003/wallet/recharge?cancelled=1

# ========== Coinbase Commerce (USDT crypto) ==========
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=

# ========== USDT (fallback manual address — usado si no hay Coinbase) ==========
USDT_ENABLED=true
USDT_MANUAL_ADDRESS=TBd5jH7XPM2QwG1pVxLqkRtjY8bD3sxA1Z
USDT_DEFAULT_CHAIN=TRC20

# ========== AES-GCM master key para cifrado de tokens de shop ==========
# Generar con:  openssl rand -base64 32
NX_TOKEN_KEKS=

# ========== Partner OAuth ==========
PARTNER_DEFAULT_SECRET=dev-partner-secret-change-me

# ========== Currency layer (para conversiones FX) ==========
NEXADROP_CURRENCY_ACCESS_KEY=

# ========== CORS ==========
CORS_ORIGINS=http://localhost:3003

# ========== Backend ==========
SERVER_PORT=18082
OAUTH_ISSUER=http://localhost:18082
DEMO_SEED_ENABLED=true
